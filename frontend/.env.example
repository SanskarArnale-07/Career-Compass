# Public API Base URL for backend scoring service (used by client-side requests)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: Internal backend URL for Next.js server-side rewrites/proxies
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Optional: OpenAI API Key for AI Career Coach LLM responses
# (Runs completely and deterministically on local grounded engine if omitted)
OPENAI_API_KEY=
